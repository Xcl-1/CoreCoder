{
  "schema_version": 2,
  "id": "coding.safe-refactor",
  "name": "Safe Refactoring",
  "version": "1.0.0",
  "summary": "Refactor existing code while preserving observable behavior and public contracts.",
  "layer": "workflow",
  "category": [
    "coding",
    "refactoring",
    "quality"
  ],
  "tags": [
    "refactor",
    "refactoring",
    "重构",
    "cleanup",
    "rename"
  ],
  "aliases": [
    "safe refactor",
    "安全重构"
  ],
  "intents": [
    "refactor this code",
    "重构这段代码",
    "rename without behavior change"
  ],
  "signature": {
    "domains": [
      "coding",
      "refactoring"
    ],
    "actions": [
      "refactor",
      "refactors",
      "refactoring",
      "refactored",
      "rename",
      "renames",
      "renaming",
      "cleanup",
      "重构",
      "重命名"
    ],
    "objects": [
      "code",
      "module",
      "modules",
      "function",
      "class",
      "代码",
      "模块"
    ],
    "artifacts": [
      "source code"
    ],
    "outputs": [
      "refactored code"
    ],
    "constraints": [
      "preserve behavior",
      "保持行为"
    ]
  },
  "applies_when": [
    "The requested change should preserve externally visible behavior."
  ],
  "not_when": [
    "change behavior",
    "新增功能",
    "fix a bug"
  ],
  "examples": {
    "positive": [
      "Refactor this module without changing its behavior",
      "重构这段代码但保持现有行为"
    ],
    "negative": [
      "Change the API and add a new feature",
      "修改业务行为并新增功能"
    ],
    "hard_negative": [
      "Implement new observable behavior"
    ],
    "contrastive": [
      {
        "query": "Add a new capability and change observable behavior",
        "expected_skill": "coding.feature-implementation",
        "reason": "Observable behavior changes are feature implementation."
      },
      {
        "query": "the tests are failing after my refactor",
        "expected_skill": "python.test-debug",
        "reason": "A failing suite after a change needs the test-debug workflow."
      }
    ]
  },
  "tools": {
    "required": [
      "read_file",
      "grep"
    ],
    "recommended": [
      "edit_ast",
      "edit_file",
      "bash"
    ],
    "forbidden": []
  },
  "exclusive_group": "implementation-mode",
  "relations": {
    "dependencies": [],
    "composes_with": [],
    "supersedes": []
  },
  "routing": {
    "allow_implicit": true,
    "risk": "medium",
    "rollout_percent": 100
  },
  "token_budget": 1000,
  "status": "active"
}
