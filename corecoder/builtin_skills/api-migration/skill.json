    "迁移 API 版本"
  ],
  "signature": {
    "domains": [
      "coding",
      "api",
      "migration"
    ],
    "actions": [
      "migrate",
      "migrates",
      "migrating",
      "migration",
      "迁移",
      "upgrade",
