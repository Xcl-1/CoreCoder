  ],
  "not_when": [
    "design a new API",
    "general feature",
    "设计新接口",
    "普通功能开发"
  ],
  "examples": {
    "positive": [
      "Migrate clients from API v1 to v2 without downtime",
      "将调用方从 API v1 平滑迁移到 v2"
    ],
    "negative": [
      "Design a brand new API contract",
      "设计新的 API 接口",
      "Design a new search endpoint",
      "修复接口返回 500"
    ],
    "hard_negative": [
      "Add a zero-downtime migration for this database column",
      "Write a migration guide from API v1 to v2 for users"
    ],
    "contrastive": [
      {
        "query": "Write a migration guide from API v1 to v2",
        "expected_skill": "docs.migration-guide",
        "reason": "Documenting an upgrade path for users is documentation work."
      },
      {
        "query": "Add a zero-downtime migration for this database column",
        "expected_skill": "data.database-migration",
        "reason": "Persisted schema changes belong to database migration."
      }
    ]
  },
  "tools": {
    "required": [
      "read_file",
      "grep"
    ],
